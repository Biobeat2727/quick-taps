generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Leaderboard entries. The table is created by prisma/sql/001_qt_scores.sql —
// the database is shared with other apps, so never `prisma db push` / `migrate`.
model QtScore {
  id         String   @id @default(cuid())
  venueId    String   @map("venue_id")
  night      String
  game       String
  kind       String
  playerName String   @map("player_name")
  playerKey  String   @map("player_key")
  value      Int
  vsHumans   Boolean  @map("vs_humans")
  sessionId  String   @map("session_id")
  dedupeKey  String   @unique @map("dedupe_key")
  countsAt   DateTime @default(now()) @map("counts_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([venueId, night, game], map: "qt_scores_board")
  @@map("qt_scores")
}
